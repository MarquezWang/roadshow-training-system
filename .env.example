DATABASE_URL="file:./dev.db"

# -----------------------------------------------------------------------------
# Auth / 登录权限
# -----------------------------------------------------------------------------
# 本地开发可设为 false；服务器/生产环境建议 true。
AUTH_ENABLED=false
# 用于签名登录 Cookie。生产环境必须设置为足够长的随机字符串。
AUTH_SECRET=
# 轮换时临时填写上一个 AUTH_SECRET；所有旧 Cookie 重签完成后应删除。
# 必须与 AUTH_SECRET 不同，生产环境下同样要求至少 32 个字符。
AUTH_SECRET_PREVIOUS=
# 可信反向代理跳数。默认 0 会忽略客户端可伪造的转发地址头；仅在部署层
# 阻断直连且每一跳代理都会覆盖/追加 X-Forwarded-For 时按实际拓扑设置。
TRUSTED_PROXY_HOPS=0
ADMIN_USERNAME=admin
# 管理员密码 SHA-256。生成方式：
# node -e "const crypto=require('crypto');console.log(crypto.createHash('sha256').update('your-password').digest('hex'))"
ADMIN_PASSWORD_HASH=

# -----------------------------------------------------------------------------
# AI 模型调用
# -----------------------------------------------------------------------------
# 当前系统通过 OpenAI 兼容协议调用 DeepSeek 等模型服务。
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=
# 旧配置 fallback：如果未配置 AI_MODEL_FAST / AI_MODEL_STRONG，会回退使用 AI_MODEL。
AI_MODEL=
# 轻量任务模型，例如 AI 连通性测试。
AI_MODEL_FAST=deepseek-v4-flash
# 关键任务模型，例如项目档案识别、TRL 判断、评委问题生成、动态追问、报告生成。
AI_MODEL_STRONG=deepseek-v4-pro
AI_TIMEOUT_MS=240000
AI_MAX_OUTPUT_TOKENS=6000
# 路演训练报告专用输出上限，降低长报告 JSON 被截断的概率。
PITCH_ANALYSIS_MAX_OUTPUT_TOKENS=12000
PITCH_ANALYSIS_REPAIR_MAX_OUTPUT_TOKENS=16000

# -----------------------------------------------------------------------------
# 语音转写 provider
# -----------------------------------------------------------------------------
# 可选值：openai | xfyun | tencent | tencent_flash
# 推荐服务器使用 tencent_flash，转写等待时间更短。
TRANSCRIPTION_PROVIDER=tencent_flash
# 单次 ASR 任务的全局硬超时（毫秒），包含转码、上传和轮询。
TRANSCRIPTION_TIMEOUT_MS=300000
# 单进程 ASR 并发与排队边界；多实例部署时仍需独立队列统一调度。
TRANSCRIPTION_MAX_CONCURRENCY=2
TRANSCRIPTION_QUEUE_TIMEOUT_MS=30000
# 所有服务商调用前均通过 ffprobe 校验原始音频的字节数和时长。
TRANSCRIPTION_MAX_AUDIO_BYTES=104857600
TRANSCRIPTION_MAX_DURATION_SEC=7200

# Document parsing worker boundaries
DOCUMENT_PARSE_TIMEOUT_MS=60000
DOCUMENT_PARSE_QUEUE_TIMEOUT_MS=30000
DOCUMENT_PARSE_MAX_CONCURRENCY=2
LIBREOFFICE_MAX_CONCURRENCY=1

# Local development defaults to running reports, recovery, and maintenance inside
# the Web process. Production must use external and manage `npm run worker:start`
# as a separate long-running process with the same DATABASE_URL and upload disk.
BACKGROUND_TASK_MODE=embedded
BACKGROUND_WORKER_POLL_INTERVAL_MS=5000
BACKGROUND_WORKER_HEARTBEAT_INTERVAL_MS=5000
BACKGROUND_WORKER_HEARTBEAT_TTL_MS=30000

# Persistent upload maintenance is opt-in. Active referenced files are never aged out.
UPLOAD_MAINTENANCE_ENABLED=false
UPLOAD_MAINTENANCE_INITIAL_DELAY_MS=30000
UPLOAD_MAINTENANCE_INTERVAL_HOURS=6
UPLOAD_ORPHAN_RETENTION_HOURS=24
UPLOAD_TEMP_RETENTION_HOURS=6
UPLOAD_ATTEMPT_RETENTION_HOURS=2
UPLOAD_TRASH_RETENTION_HOURS=24
UPLOAD_MISSING_REFERENCE_GRACE_MINUTES=10
# 新建项目暂存材料令牌和文件的保留时间（0.25–24 小时）。
PROJECT_MATERIAL_RETENTION_HOURS=2

# OpenAI Whisper 模式需要：
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_MODEL=whisper-1

# -----------------------------------------------------------------------------
# 讯飞云 ASR：TRANSCRIPTION_PROVIDER=xfyun 时使用
# -----------------------------------------------------------------------------
XFYUN_APP_ID=
XFYUN_SECRET_KEY=
XFYUN_LANGUAGE=cn
# 正式环境建议保持 false，避免保存调试文件或临时音频。
XFYUN_DEBUG=false
XFYUN_KEEP_TEMP_AUDIO=false

# -----------------------------------------------------------------------------
# 腾讯云 ASR 通用密钥
# -----------------------------------------------------------------------------
# tencent 和 tencent_flash 都需要 SecretId / SecretKey。
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# 兼容腾讯云常见环境变量命名；如果不使用可留空。
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=

# -----------------------------------------------------------------------------
# 腾讯云普通录音文件识别：TRANSCRIPTION_PROVIDER=tencent 时使用
# -----------------------------------------------------------------------------
TENCENT_ASR_REGION=ap-guangzhou
TENCENT_ASR_ENGINE_MODEL_TYPE=16k_zh
TENCENT_ASR_ENDPOINT=
TENCENT_ASR_POLL_INTERVAL_MS=3000
TENCENT_ASR_MAX_POLL_COUNT=120

# -----------------------------------------------------------------------------
# 腾讯云录音文件识别极速版：TRANSCRIPTION_PROVIDER=tencent_flash 时使用
# -----------------------------------------------------------------------------
# 腾讯云账号 AppID，不是 SecretId。
TENCENT_APP_ID=
# 兼容腾讯云常见环境变量命名；如果不使用可留空。
TENCENTCLOUD_APP_ID=
TENCENT_ASR_FLASH_ENGINE_TYPE=16k_zh
TENCENT_ASR_FLASH_VOICE_FORMAT=mp3
# 3 表示返回带标点分段时间戳，用于报告页按页匹配转写内容。
TENCENT_ASR_FLASH_WORD_INFO=3
TENCENT_ASR_FLASH_TIMEOUT_MS=120000

# -----------------------------------------------------------------------------
# 腾讯云语音合成 TTS：答辩评委读题测试分支使用
# -----------------------------------------------------------------------------
# 复用 TENCENT_SECRET_ID / TENCENT_SECRET_KEY；如不配置 region/endpoint 使用默认值。
TENCENT_TTS_REGION=ap-guangzhou
TENCENT_TTS_ENDPOINT=tts.tencentcloudapi.com

# -----------------------------------------------------------------------------
# PPT / PPTX 转 PDF 预览
# -----------------------------------------------------------------------------
# Linux 服务器通常留空，系统会尝试 libreoffice / soffice 命令。
# Windows 本地可示例：
# LIBREOFFICE_PATH="C:\Program Files\LibreOffice\program\soffice.com"
LIBREOFFICE_PATH=

# -----------------------------------------------------------------------------
# 功能开关
# -----------------------------------------------------------------------------
# 材料诊断模拟模式。生产环境建议 false。
DIAGNOSIS_MOCK_MODE=false
# 动态追问实验开关。true 时 QA 阶段可根据路演内容生成追问。
DYNAMIC_FOLLOWUP_EXPERIMENT=false

# -----------------------------------------------------------------------------
# 测试专用
# -----------------------------------------------------------------------------
# 稳定性测试默认不会写入开发数据库。需要真实执行时，配置独立测试库。
STABILITY_TEST_DATABASE_URL=
# AI 资源配额（单实例分钟限频/并发 + 数据库持久化每日预算）
AI_USER_REQUESTS_PER_MINUTE=20
AI_USER_DAILY_REQUESTS=500
# 每日预算不得低于系统单次请求预占硬上限 500000 Token。
AI_USER_DAILY_TOKENS=500000
AI_USER_MAX_CONCURRENT=3
AI_SCOPE_MAX_CONCURRENT=1
AI_GLOBAL_MAX_CONCURRENT=10
AI_PROVIDER_FAILURE_THRESHOLD=3
AI_PROVIDER_BACKOFF_MS=30000
