DATABASE_URL="file:./dev.db"

# 文本分析 / QA / 报告评分（对话模型）
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=3000

# 音频转写（独立配置，支持 openai / xfyun）
# 可选值：openai | xfyun
TRANSCRIPTION_PROVIDER=openai
# openai 模式必填：
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_MODEL=whisper-1
# xfyun 模式必填：
XFYUN_APP_ID=
XFYUN_SECRET_KEY=
XFYUN_LANGUAGE=cn
# XFYUN_DEBUG=true：开启讯飞接口调试日志和 debug JSON 文件保存
# XFYUN_KEEP_TEMP_AUDIO=true：保留转码后的 wav 文件，便于本地排查
# 正式环境建议 XFYUN_DEBUG=false、XFYUN_KEEP_TEMP_AUDIO=false
XFYUN_DEBUG=false
XFYUN_KEEP_TEMP_AUDIO=false

DIAGNOSIS_MOCK_MODE=false
