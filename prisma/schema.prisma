generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  passwordHash String?
  role      String    @default("TEAM")
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Project {
  id                      String               @id @default(cuid())
  ownerId                 String
  owner                   User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                    String
  field                   String
  stage                   String
  summary                 String
  coreTechnology          String
  applicationScenario     String
  businessModel           String
  cooperationDemand       String
  productForm             String               @default("")
  trlBasis                String               @default("")
  teamInfo                String               @default("")
  cooperationDemandDetail String               @default("")
  needsConversionSupport  Boolean              @default(false)
  projectContact          String               @default("")
  contactPhone            String               @default("")
  fileAssets              FileAsset[]
  diagnoses               Diagnosis[]
  scoreResults            ScoreResult[]
  questions               Question[]
  reports                 Report[]
  trainingSessions        TrainingSession[]
  trainingRecordings      TrainingRecording[]
  trainingTranscripts     TrainingTranscript[]
  trainingAnalyses        TrainingAnalysis[]
  trainingQuestions       TrainingQuestion[]
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@index([ownerId])
}

model FileAsset {
  id                 String       @id @default(cuid())
  projectId          String
  project            Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  originalName       String
  fileType           String
  filePath           String
  fileSize           Int
  extractedText      String?
  parseStatus        String       @default("PENDING")
  parseError         String?
  previewPdfPath     String?
  previewStatus      String       @default("NONE")
  previewError       String?
  includeInAIContext Boolean      @default(true)
  slideEvents        SlideEvent[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([projectId])
}

model TrainingSession {
  id                String               @id @default(cuid())
  projectId         String
  project           Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status            String               @default("CREATED")
  pitchStartedAt    DateTime?
  pitchEndedAt      DateTime?
  pitchDurationSec  Int?
  qaStartedAt       DateTime?
  qaEndedAt         DateTime?
  qaDurationSec     Int?
  currentPageIndex  Int                  @default(0)
  slideEvents       SlideEvent[]
  recordings        TrainingRecording[]
  transcripts       TrainingTranscript[]
  analyses          TrainingAnalysis[]
  trainingQuestions TrainingQuestion[]
  trainingAnswers   TrainingAnswer[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([projectId])
  @@index([status])
}

model SlideEvent {
  id         String          @id @default(cuid())
  sessionId  String
  session    TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fileId     String?
  file       FileAsset?      @relation(fields: [fileId], references: [id], onDelete: SetNull)
  pageIndex  Int
  eventType  String
  elapsedSec Int
  createdAt  DateTime        @default(now())

  @@index([sessionId])
  @@index([fileId])
}

model TrainingRecording {
  id           String              @id @default(cuid())
  sessionId    String
  session      TrainingSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase        String              @default("PITCH")
  status       String              @default("RECORDED")
  originalName String?
  fileName     String
  filePath     String
  mimeType     String
  sizeBytes    Int
  durationSec  Int?
  startedAt    DateTime?
  endedAt      DateTime?
  transcript   TrainingTranscript?
  answer       TrainingAnswer?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([sessionId])
  @@index([projectId])
  @@index([phase])
  @@index([status])
}

model TrainingTranscript {
  id           String             @id @default(cuid())
  recordingId  String             @unique
  recording    TrainingRecording  @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  sessionId    String
  session      TrainingSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status       String             @default("PENDING")
  source       String             @default("MANUAL")
  language     String             @default("zh-CN")
  text         String
  segmentsJson String?
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  analyses     TrainingAnalysis[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([sessionId])
  @@index([projectId])
  @@index([status])
  @@index([source])
}

model TrainingAnalysis {
  id                String              @id @default(cuid())
  sessionId         String
  session           TrainingSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  projectId         String
  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  transcriptId      String?
  transcript        TrainingTranscript? @relation(fields: [transcriptId], references: [id], onDelete: SetNull)
  status            String              @default("PENDING")
  analysisType      String              @default("PITCH")
  durationSec       Int
  pageCount         Int?
  slideEventCount   Int?
  overallScore      Int?
  summary           String
  strengthsJson     String
  weaknessesJson    String
  suggestionsJson   String
  coverageJson      String
  timingJson        String
  slideSyncJson     String
  riskQuestionsJson String
  rawResultJson     String
  errorMessage      String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([sessionId])
  @@index([projectId])
  @@index([transcriptId])
  @@index([status])
  @@index([analysisType])
}

model TrainingQuestion {
  id           String          @id @default(cuid())
  sessionId    String
  session      TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  orderIndex   Int
  questionText String
  questionType String?
  source       String          @default("AI")
  basis        String?
  answer       TrainingAnswer?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([sessionId, orderIndex])
  @@index([sessionId])
  @@index([projectId])
  @@index([source])
}

model TrainingAnswer {
  id                   String             @id @default(cuid())
  sessionId            String
  session              TrainingSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId           String             @unique
  question             TrainingQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  recordingId          String?            @unique
  recording            TrainingRecording? @relation(fields: [recordingId], references: [id], onDelete: SetNull)
  answerText           String?
  revealedQuestionText Boolean            @default(false)
  startedAt            DateTime?
  endedAt              DateTime?
  durationSec          Int?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([sessionId])
  @@index([recordingId])
}

model Diagnosis {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  summary      String
  completeness String
  issues       String
  risks        String
  suggestions  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([projectId])
}

model ScoreResult {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ruleId      String?
  rule        EvaluationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  totalScore  Int
  scoreDetail String
  comments    String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([projectId])
  @@index([ruleId])
}

model Question {
  id                 String   @id @default(cuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type               String
  perspective        String
  content            String
  focus              String
  suggestedDirection String
  evidenceText       String?
  evidenceLocation   String?
  factCheckNote      String?
  answers            Answer[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([projectId])
}

model Answer {
  id         String    @id @default(cuid())
  questionId String
  question   Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  content    String
  feedback   Feedback?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([questionId])
}

model Feedback {
  id              String   @id @default(cuid())
  answerId        String   @unique
  answer          Answer   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  evaluation      String
  missingPoints   String
  risks           String
  suggestedAnswer String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Report {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model EvaluationRule {
  id           String                @id @default(cuid())
  name         String
  contestName  String
  version      String
  totalScore   Int                   @default(100)
  description  String?
  rawText      String?
  criteria     EvaluationCriterion[]
  scoreResults ScoreResult[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([contestName, version])
}

model EvaluationCriterion {
  id           String         @id @default(cuid())
  ruleId       String
  rule         EvaluationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  category     String?
  name         String
  weight       Int
  description  String
  scoringGuide String?
  sortOrder    Int
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([ruleId])
}

model ExpertComment {
  id             String   @id @default(cuid())
  contestName    String?
  projectField   String?
  dimension      String
  commentText    String
  problemType    String?
  suggestionType String?
  scoreRange     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([dimension])
}

model HistoricalQuestion {
  id           String   @id @default(cuid())
  contestName  String?
  projectField String?
  perspective  String
  questionText String
  focus        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([perspective])
  @@index([projectField])
}

model KnowledgeSource {
  id        String   @id @default(cuid())
  title     String
  type      String
  filePath  String?
  rawText   String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
}
